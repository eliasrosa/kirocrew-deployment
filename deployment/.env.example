# KiroCrew Flow — variáveis de ambiente (secrets)
#
# Copie este arquivo para .env ao lado de deployment.config.yaml:
#   cp deployment/.env.example ~/.kiro/crew/crons/.env
#
# O .env é carregado automaticamente pelo deployment.py (via python-dotenv,
# com fallback silencioso quando python-dotenv não está instalado).
#
# NUNCA versione o .env com valores reais — ele já está no .gitignore.
# Para o arquivo de exemplo do repo, mantenha todos os valores como placeholders.
#
# Este arquivo é a fonte AUTORITATIVA do conjunto de secrets: o install-cron.sh
# semeia o ~/.kiro/crew/crons/.env a partir dele, então ele deve conter TODOS os
# secrets declarados em config.example.yaml (KIROCREW_WEBHOOK_TOKEN,
# KIROCREW_WEBHOOK_SECRET e AZURE_DEVOPS_PAT). O ../.env.example na raiz do repo
# é uma cópia equivalente para uso em desenvolvimento local; mantenha os dois em
# sincronia ao adicionar um novo secret.

# Token Bearer do webhook do dashboard (Settings → Webhooks → agente: kirocrew).
# Necessário para despachar sessões one-shot a partir de cron script-based.
# Sem ele o dispatch cai no fallback loopback interno (ctx._port), que só funciona
# em crons LLM-based (não em script-based).
KIROCREW_WEBHOOK_TOKEN=

# Signing secret HMAC-SHA256 do webhook.
# Necessário quando o webhook exige assinatura; sem ele o POST é rejeitado com 401.
KIROCREW_WEBHOOK_SECRET=

# PAT (Personal Access Token) para autenticação na REST API do Azure DevOps.
# Gere em: https://dev.azure.com/<org>/_usersSettings/tokens
# Escopos necessários: Code (Read & Write).
# Obrigatório quando o issue_provider é azure_devops; sem ele o adapter falha
# com ProviderSetupError.
AZURE_DEVOPS_PAT=

# URL do webhook (sobrescreve webhook_url no deployment.config.yaml).
# Padrão: http://localhost:5478/api/hooks/agent
# KIROCREW_WEBHOOK_URL=
